<?xml version="1.0"?>
<robot name="simple_bot">

  <!-- ── Materials (colours for RViz) ──────────────────────────────── -->
  <material name="blue">  <color rgba="0.2 0.4 0.8 1.0"/> </material>
  <material name="black"> <color rgba="0.1 0.1 0.1 1.0"/> </material>
  <material name="grey">  <color rgba="0.5 0.5 0.5 1.0"/> </material>
  <material name="white"> <color rgba="0.95 0.95 0.95 1.0"/> </material>

  <!-- ── base_footprint — virtual link at ground level ─────────────── -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
    <!--        ↑ wheel_radius (0.03) + chassis_half_height (0.03) = 0.06 m
                This lifts the chassis centre so the wheels (z=-0.03 below base_link)
                have their bottoms exactly at ground level.
                Result: chassis bottom is 0.03 m above ground (3 cm clearance). -->
  </joint>

  <!-- ── Chassis ────────────────────────────────────────────────────── -->
  <link name="base_link">
    <visual>
      <geometry> <box size="0.20 0.14 0.06"/> </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry> <box size="0.20 0.14 0.06"/> </geometry>
    </collision>
    <inertial>
      <mass value="0.8"/>
      <!-- Inertia values for a solid box: I = m(a²+b²)/12 -->
      <inertia ixx="0.00183" ixy="0" ixz="0"
               iyy="0.00283" iyz="0"
               izz="0.00347"/>
    </inertial>
  </link>

  <!-- ── Left wheel ─────────────────────────────────────────────────── -->
  <link name="left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <!--                  ↑ 90° roll so cylinder axis aligns with Y (sideways) -->
      <geometry> <cylinder radius="0.03" length="0.02"/> </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry> <cylinder radius="0.03" length="0.02"/> </geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.000038" ixy="0" ixz="0"
               iyy="0.000038" iyz="0"
               izz="0.000068"/>
    </inertial>
  </link>

  <!-- type="continuous" means no angle limits — wheel spins freely -->
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child  link="left_wheel_link"/>
    <origin xyz="-0.05 0.08 -0.03" rpy="0 0 0"/>
    <!--          ↑rear  ↑left  ↑bottom of chassis -->
    <axis xyz="0 1 0"/>  <!-- rotation axis = Y (sideways) -->
    <dynamics damping="0.01" friction="0.1"/>
  </joint>

  <!-- ── Right wheel ────────────────────────────────────────────────── -->
  <link name="right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry> <cylinder radius="0.03" length="0.02"/> </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry> <cylinder radius="0.03" length="0.02"/> </geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.000038" ixy="0" ixz="0"
               iyy="0.000038" iyz="0"
               izz="0.000068"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child  link="right_wheel_link"/>
    <origin xyz="-0.05 -0.08 -0.03" rpy="0 0 0"/>
    <!--                 ↑right -->
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.1"/>
  </joint>

  <!-- ── Front caster (passive ball, keeps robot balanced) ─────────── -->
  <link name="caster_link">
    <visual>
      <geometry> <sphere radius="0.018"/> </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry> <sphere radius="0.018"/> </geometry>
    </collision>
    <inertial>
      <mass value="0.03"/>
      <inertia ixx="0.0000019" ixy="0" ixz="0"
               iyy="0.0000019" iyz="0"
               izz="0.0000019"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="caster_link"/>
    <origin xyz="0.08 0 -0.042" rpy="0 0 0"/>
    <!--         ↑front
                 z = caster_radius - base_footprint_joint_z = 0.018 - 0.06 = -0.042
                 → caster centre at 0.018 m above ground = caster_radius ✓
                 → caster bottom at 0.000 m (touches ground) ✓ -->
  </joint>

  <!-- ── Camera ────────────────────────────────────────────────────── -->
  <!--
    Mounted at the front-top of the chassis.
    Pitched 30° downward (0.5236 rad) so it looks at the floor ahead.
    At ~0.115 m height × tan(30°) ≈ 0.20 m look-ahead distance.
  -->
  <link name="camera_link">
    <visual>
      <geometry> <box size="0.02 0.025 0.015"/> </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry> <box size="0.02 0.025 0.015"/> </geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.0000009" ixy="0" ixz="0"
               iyy="0.0000008" iyz="0"
               izz="0.0000013"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="camera_link"/>
    <origin xyz="0.09 0 0.03" rpy="0 0.5236 0"/>
    <!--        ↑front  ↑top   ↑30° downward pitch -->
  </joint>

  <!-- ROS optical frame: Z forward, X right, Y down (REP-103) -->
  <link name="camera_optical_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child  link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- ── Gazebo: Differential Drive Plugin ─────────────────────────── -->
  <!--
    This plugin makes Gazebo simulate a differential-drive controller.
    It reads /cmd_vel and drives the wheels accordingly.
    It also publishes /odom (odometry).
  -->
  <gazebo>
    <plugin name="gazebo_ros_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros><namespace>/</namespace></ros>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.16</wheel_separation>
      <wheel_diameter>0.06</wheel_diameter>
      <max_wheel_torque>5.0</max_wheel_torque>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- ── Gazebo: Camera Plugin ─────────────────────────────────────── -->
  <!--
    This plugin makes Gazebo render camera images and publish them
    to the ROS topic /camera/image_raw.
  -->
  <gazebo reference="camera_link">
    <sensor name="rgb_camera" type="camera">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>30</update_rate>
      <camera name="camera">
        <horizontal_fov>1.0472</horizontal_fov>  <!-- 60° -->
        <image>
          <width>320</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <clip><near>0.02</near><far>8.0</far></clip>
      </camera>
      <plugin name="gazebo_ros_camera" filename="libgazebo_ros_camera.so">
        <ros><namespace>/</namespace></ros>
        <camera_name>camera</camera_name>
        <frame_name>camera_optical_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Frictionless caster -->
  <gazebo reference="caster_link">
    <mu1>0.0</mu1> <mu2>0.0</mu2>
  </gazebo>

  <!-- Wheel grip -->
  <gazebo reference="left_wheel_link">
    <mu1>1.5</mu1> <mu2>1.5</mu2>
  </gazebo>
  <gazebo reference="right_wheel_link">
    <mu1>1.5</mu1> <mu2>1.5</mu2>
  </gazebo>

</robot>